rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 공개 페이지는 읽기만 허용하고, 지정한 관리자 계정만 데이터를 변경할 수 있습니다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "alsgh2862@naver.com";
    }

    match /schedules/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /books/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryPhotos/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quotes/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
