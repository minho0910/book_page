rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 공개 페이지는 읽기만 허용하고, Firebase Authentication으로 로그인한
    // 관리자만 사이트 데이터를 변경할 수 있습니다.
    match /schedules/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /books/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /galleryPhotos/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
